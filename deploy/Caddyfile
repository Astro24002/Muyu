{$PUBLIC_DOMAIN} {
	encode zstd gzip

	# Authenticated API and WebSocket responses must never be cached.
	handle /api/v1/realtime* {
		header Cache-Control "no-store"
		reverse_proxy api:8080
	}
	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy api:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; img-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
	root * /srv
	route {
		try_files {path} /index.html
		# The rewritten SPA fallback is not guaranteed to match /index.html.
		# Keep HTML and fallback responses uncacheable, while fingerprinted Vite
		# assets remain cacheable.
		header Cache-Control "no-store"
		@static path /assets/*
		header @static Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
