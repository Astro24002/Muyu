# This file is for an explicit local-only stack. Replace every change-this
# value before using it outside a developer machine.
PUBLIC_DOMAIN=localhost
POSTGRES_DB=muyu_cloud
POSTGRES_USER=muyu
POSTGRES_PASSWORD=change-this-local-database-password
OTP_PEPPER=change-this-otp-pepper-to-at-least-32-characters
OTP_PROVIDER=fake
OTP_PROVIDER_URL=http://sms-provider.invalid/send
OTP_PROVIDER_API_KEY=local-fake-provider-key
SMS_SIGN_ID=local-fake-sign-id
SMS_TEMPLATE_ID=local-fake-template-id
PUBLIC_BASE_URL=http://localhost
WEB_ORIGIN=http://localhost
ALLOWED_ORIGINS=http://localhost
ALLOWED_HOSTS=localhost
TRUSTED_PROXY_IPS=127.0.0.1
WEB_COOKIE_SECURE=false
BACKUP_REPOSITORY_URL=/var/lib/pgbackrest
BACKUP_REPOSITORY_USER=local-backup
BACKUP_REPOSITORY_PASSWORD=change-this-local-backup-password
BACKUP_ENCRYPTION_KEY=change-this-local-backup-encryption-key
BACKUP_RETENTION_FULL=7
BACKUP_RETENTION_DIFF=14
