# Production template for muyu.bkverse.space. Copy to deploy/.env on the host
# and replace every change-this value before starting the stack.
PUBLIC_DOMAIN=muyu.bkverse.space
POSTGRES_DB=muyu_cloud
POSTGRES_USER=muyu
POSTGRES_PASSWORD=change-this-production-database-password
OTP_PEPPER=change-this-production-otp-pepper-to-at-least-32-characters
OTP_PROVIDER=production
OTP_PROVIDER_URL=https://gyytz.market.alicloudapi.com/sms/smsSend
OTP_PROVIDER_API_KEY=change-this-production-sms-provider-key
SMS_SIGN_ID=2e65b1bb3d054466b82f0c9d125465e2
SMS_TEMPLATE_ID=908e94ccf08b4476ba6c876d13f084ad
PUBLIC_BASE_URL=https://muyu.bkverse.space
WEB_ORIGIN=https://muyu.bkverse.space
ALLOWED_ORIGINS=https://muyu.bkverse.space
ALLOWED_HOSTS=muyu.bkverse.space
TRUSTED_PROXY_IPS=127.0.0.1
WEB_COOKIE_SECURE=true
BACKUP_REPOSITORY_URL=/var/lib/pgbackrest
BACKUP_REPOSITORY_USER=change-this-production-backup-user
BACKUP_REPOSITORY_PASSWORD=change-this-production-backup-password
BACKUP_ENCRYPTION_KEY=change-this-production-backup-encryption-key
BACKUP_RETENTION_FULL=7
BACKUP_RETENTION_DIFF=14
